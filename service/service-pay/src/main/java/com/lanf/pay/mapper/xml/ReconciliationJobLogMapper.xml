<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.lanf.pay.mapper.ReconciliationJobLogMapper">

    <insert id="batchInsertIgnore">
        INSERT IGNORE INTO reconciliation_job_log (
        id,
        batch_id,
        job_type,
        status,
        create_time,
        update_time
        ) VALUES
        <foreach collection="list" item="item" separator="," >
            (
            #{item.id},
            #{item.batchId},
            #{item.jobType},
            #{item.status},
            NOW(),
            NOW()
            )
        </foreach>
    </insert>

</mapper>
